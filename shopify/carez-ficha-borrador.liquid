{%- doc -%}
BORRADOR Carez: ficha de producto ampliada (por qué este diseño, qué incluye,
cómo funciona, material y garantías, preguntas frecuentes y montaje).
Los textos se editan desde los ajustes del bloque; los valores por defecto
son los del Kit Adhesivos Yamaha MT-07 Racing Blue.
{%- enddoc -%}
{% liquid
assign product = closest.product
assign incluye = block.settings.incluye | newline_to_br | split: '<br />'
assign aparte = block.settings.aparte | newline_to_br | split: '<br />'
%}
{% style %}
.cf-{{ block.id }} { color: #f2f1ee; font-family: inherit; }
.cf-{{ block.id }} * { box-sizing: border-box; }
.cf-grid-{{ block.id }} { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.cf-card-{{ block.id }} { background: #17171a; border: 1px solid #232226; border-radius: 12px; padding: 22px; display: grid; gap: 12px; align-content: start; }
.cf-card-{{ block.id }}.cf-full-{{ block.id }} { grid-column: 1 / -1; }
.cf-h-{{ block.id }} { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 22px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; margin: 0; display: flex; align-items: center; gap: 10px; color: #f2f1ee; }
.cf-h-{{ block.id }}::before { content: ''; width: 18px; height: 3px; background: #c9a24b; border-radius: 2px; }
.cf-p-{{ block.id }} { margin: 0; font-size: 14.5px; line-height: 1.55; color: #cfcdc8; }
.cf-p-{{ block.id }} strong { color: #f2f1ee; }
.cf-why-{{ block.id }} { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
.cf-why-{{ block.id }} li { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; }
.cf-ic-{{ block.id }} { width: 34px; height: 34px; border-radius: 6px; background: rgba(201, 162, 75, 0.14); color: #c9a24b; display: grid; place-items: center; font-family: 'Barlow Condensed', Arial, sans-serif; font-weight: 800; font-size: 15px; }
.cf-why-{{ block.id }} b { display: block; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 19px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; }
.cf-why-{{ block.id }} span.cf-t-{{ block.id }} { font-size: 14.5px; color: #cfcdc8; line-height: 1.5; }
.cf-inc-{{ block.id }} { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.cf-inc-{{ block.id }} h4 { margin: 0 0 8px; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #c9a24b; }
.cf-inc-{{ block.id }} ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 5px; font-size: 14.5px; color: #cfcdc8; }
.cf-inc-{{ block.id }} .cf-yes-{{ block.id }} li::before { content: '\25CF'; color: #c9a24b; margin-right: 8px; font-size: 11px; }
.cf-inc-{{ block.id }} .cf-no-{{ block.id }} li::before { content: '\25CB'; color: #9a9894; margin-right: 8px; font-size: 11px; }
.cf-note-{{ block.id }} { grid-column: 1 / -1; font-size: 13px; color: #9a9894; margin: 0; }
.cf-steps-{{ block.id }} { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; counter-reset: s; margin: 0; padding: 0; list-style: none; }
.cf-steps-{{ block.id }} li { counter-increment: s; padding: 14px 0; border-top: 2px solid #232226; }
.cf-steps-{{ block.id }} li::before { content: '0' counter(s); font-size: 12px; color: #c9a24b; display: block; margin-bottom: 6px; letter-spacing: 0.1em; }
.cf-steps-{{ block.id }} b { display: block; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 20px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; }
.cf-steps-{{ block.id }} span { font-size: 13.5px; color: #cfcdc8; }
.cf-spec-{{ block.id }} { width: 100%; border-collapse: collapse; font-size: 14.5px; }
.cf-spec-{{ block.id }} th { text-align: left; font-weight: 600; color: #9a9894; padding: 8px 0; border-bottom: 1px solid #232226; width: 36%; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; vertical-align: top; }
.cf-spec-{{ block.id }} td { padding: 8px 0; border-bottom: 1px solid #232226; color: #f2f1ee; }
.cf-spec-{{ block.id }} tr:last-child th, .cf-spec-{{ block.id }} tr:last-child td { border-bottom: 0; }
.cf-guar-{{ block.id }} { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.cf-guar-{{ block.id }} div { background: rgba(201, 162, 75, 0.10); border: 1px solid rgba(201, 162, 75, 0.25); border-radius: 8px; padding: 12px; display: grid; gap: 2px; }
.cf-guar-{{ block.id }} b { font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 22px; font-weight: 800; text-transform: uppercase; color: #c9a24b; line-height: 1; }
.cf-guar-{{ block.id }} span { font-size: 13px; color: #cfcdc8; }
.cf-{{ block.id }} details { border-top: 1px solid #232226; }
.cf-{{ block.id }} details:last-of-type { border-bottom: 1px solid #232226; }
.cf-{{ block.id }} summary { cursor: pointer; padding: 12px 0; font-weight: 600; font-size: 15px; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
.cf-{{ block.id }} summary::-webkit-details-marker { display: none; }
.cf-{{ block.id }} summary::after { content: '+'; color: #c9a24b; flex: none; }
.cf-{{ block.id }} details[open] summary::after { content: '\2013'; }
.cf-{{ block.id }} details p { padding-bottom: 14px; }
.cf-upsell-{{ block.id }} { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr auto; gap: 18px; align-items: center; background: #17171a; border: 1px solid rgba(201, 162, 75, 0.35); border-radius: 12px; padding: 18px 20px; }
.cf-upsell-{{ block.id }} img { width: 110px; height: 110px; object-fit: cover; border-radius: 8px; }
.cf-upsell-{{ block.id }} h3 { margin: 0 0 6px; font-family: 'Barlow Condensed', Arial, sans-serif; font-size: 26px; font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; color: #f2f1ee; }
.cf-btn-{{ block.id }} { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; border-radius: 10px; background: #c9a24b; color: #0b0b0d; border: 0; cursor: pointer; font-family: 'Barlow Condensed', Arial, sans-serif; font-weight: 800; font-size: 18px; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
.cf-btn-{{ block.id }}:hover { filter: brightness(1.08); }
@media screen and (max-width: 900px) {
.cf-grid-{{ block.id }} { grid-template-columns: 1fr; }
.cf-guar-{{ block.id }} { grid-template-columns: 1fr; }
.cf-upsell-{{ block.id }} { grid-template-columns: 1fr; }
.cf-upsell-{{ block.id }} img { width: 100%; height: 160px; }
}
@media screen and (max-width: 520px) {
.cf-inc-{{ block.id }} { grid-template-columns: 1fr; }
.cf-steps-{{ block.id }} { grid-template-columns: 1fr; }
}
{% endstyle %}
<div class="cf-{{ block.id }}" {{ block.shopify_attributes }}>
<div class="cf-grid-{{ block.id }}">
<section class="cf-card-{{ block.id }}">
<h3 class="cf-h-{{ block.id }}">{{ block.settings.why_title }}</h3>
<ul class="cf-why-{{ block.id }}">
<li><span class="cf-ic-{{ block.id }}">{{ block.settings.why_1_tag }}</span><div><b>{{ block.settings.why_1_title }}</b><span class="cf-t-{{ block.id }}">{{ block.settings.why_1_text }}</span></div></li>
<li><span class="cf-ic-{{ block.id }}">{{ block.settings.why_2_tag }}</span><div><b>{{ block.settings.why_2_title }}</b><span class="cf-t-{{ block.id }}">{{ block.settings.why_2_text }}</span></div></li>
<li><span class="cf-ic-{{ block.id }}">{{ block.settings.why_3_tag }}</span><div><b>{{ block.settings.why_3_title }}</b><span class="cf-t-{{ block.id }}">{{ block.settings.why_3_text }}</span></div></li>
</ul>
<p class="cf-p-{{ block.id }}"><strong>Brillo, mate o glitter:</strong> {{ block.settings.acabados_text }}</p>
</section>
<section class="cf-card-{{ block.id }}">
<h3 class="cf-h-{{ block.id }}">Qué incluye el kit</h3>
<div class="cf-inc-{{ block.id }}">
<div class="cf-yes-{{ block.id }}"><h4>Incluido</h4><ul>{% for item in incluye %}{% assign it = item | strip %}{% if it != blank %}<li>{{ it }}</li>{% endif %}{% endfor %}</ul></div>
<div class="cf-no-{{ block.id }}"><h4>Se pide aparte</h4><ul>{% for item in aparte %}{% assign it = item | strip %}{% if it != blank %}<li>{{ it }}</li>{% endif %}{% endfor %}</ul></div>
<p class="cf-note-{{ block.id }}">El contenido exacto puede variar ligeramente según el modelo seleccionado. Los elementos opcionales se pueden añadir al pedido.</p>
</div>
</section>
<section class="cf-card-{{ block.id }}">
<h3 class="cf-h-{{ block.id }}">Cómo funciona</h3>
<ol class="cf-steps-{{ block.id }}">
<li><b>Configura</b><span>{{ block.settings.step_1_text }}</span></li>
<li><b>Revisa</b><span>Te enviamos una previsualización del diseño final para que la apruebes. Los 2 primeros cambios van incluidos.</span></li>
<li><b>Fabricamos</b><span>Troquelamos el kit en vinilo de 485 μm con las plantillas de tu modelo y año.</span></li>
<li><b>Monta o trae</b><span>Lo montas tú o lo hacemos en nuestro taller de Martorell si lo has marcado.</span></li>
</ol>
</section>
<section class="cf-card-{{ block.id }}">
<h3 class="cf-h-{{ block.id }}">Material y garantías</h3>
<table class="cf-spec-{{ block.id }}">
<tr><th>Material</th><td>Vinilo premium de 485 μm, alta adherencia. Impactos, rayaduras, agua, sol y uso intensivo.</td></tr>
<tr><th>Base</th><td>Normal · Cromado · Holográfico</td></tr>
<tr><th>Acabado</th><td>Brillo · Mate · Glitter</td></tr>
<tr><th>Compatibilidad</th><td>{{ block.settings.compat_text }}</td></tr>
<tr><th>Garantía</th><td>365 días. Pintura intacta: el vinilo se retira sin dañarla.</td></tr>
<tr><th>Envío</th><td>{{ block.settings.envio_text }}</td></tr>
<tr><th>Devolución</th><td>{{ block.settings.devolucion_text }}</td></tr>
</table>
<div class="cf-guar-{{ block.id }}">
<div><b>Envío gratis</b><span>{{ block.settings.envio_corto }}</span></div>
<div><b>30 días</b><span>Devolución de productos de catálogo sin usar.</span></div>
<div><b>Taller propio</b><span>Montaje profesional en Martorell, más de 6 años instalando.</span></div>
</div>
</section>
<section class="cf-card-{{ block.id }} cf-full-{{ block.id }}">
<h3 class="cf-h-{{ block.id }}">Preguntas frecuentes</h3>
{% if block.settings.faq_1_q != blank %}<details><summary>{{ block.settings.faq_1_q }}</summary><p class="cf-p-{{ block.id }}">{{ block.settings.faq_1_a }}</p></details>{% endif %}
{% if block.settings.faq_2_q != blank %}<details><summary>{{ block.settings.faq_2_q }}</summary><p class="cf-p-{{ block.id }}">{{ block.settings.faq_2_a }}</p></details>{% endif %}
{% if block.settings.faq_3_q != blank %}<details><summary>{{ block.settings.faq_3_q }}</summary><p class="cf-p-{{ block.id }}">{{ block.settings.faq_3_a }}</p></details>{% endif %}
<details><summary>¿La moto queda igual que en el render?</summary><p class="cf-p-{{ block.id }}">El render es una representación digital. Líneas, proporciones o gráficos pueden ajustarse a tu modelo, y lo ves en la previsualización real antes de fabricar.</p></details>
</section>
<aside class="cf-upsell-{{ block.id }}">
{% if block.settings.montaje_image %}<img src="{{ block.settings.montaje_image | image_url: width: 300 }}" alt="Montaje de un kit de adhesivos en el taller de Carez Designs" loading="lazy" width="110" height="110">{% endif %}
<div>
<h3>¿Sin experiencia colocando vinilos? Lo montamos nosotros.</h3>
<p class="cf-p-{{ block.id }}">Servicio de instalación en Martorell (08760). Cita tras confirmar el pedido, instaladores con más de 6 años de experiencia y entrega sin burbujas ni fallos. Si son plásticos sueltos, puedes enviarlos.</p>
</div>
<button type="button" class="cf-btn-{{ block.id }}" data-cf-open-montaje>Añadir montaje · desde {{ block.settings.montaje_desde }}</button>
</aside>
</div>
</div>
<script>
(function () {
var btn = document.querySelector('[data-cf-open-montaje]');
if (!btn) return;
btn.addEventListener('click', function () {
var open = document.querySelector('[data-cz-open]');
if (open) { open.click(); }
window.setTimeout(function () {
var t = document.querySelector('[data-cz-addon-toggle="montaje"]');
if (t && t.getAttribute('aria-expanded') !== 'true') { t.click(); }
if (t) { try { t.scrollIntoView({ block: 'center' }); } catch (e) {} }
}, 700);
});
})();
</script>
{% schema %}
{
"name": "Ficha borrador Carez",
"tag": null,
"settings": [
{ "type": "header", "content": "Por qué este diseño" },
{ "type": "text", "id": "why_title", "label": "Título", "default": "Por qué este diseño" },
{ "type": "text", "id": "why_1_tag", "label": "Etiqueta 1", "default": "AZ" },
{ "type": "text", "id": "why_1_title", "label": "Motivo 1", "default": "El azul histórico de Yamaha" },
{ "type": "textarea", "id": "why_1_text", "label": "Texto 1", "default": "Deportivo sin romper la estética de fábrica. Es el color que la marca lleva a competición." },
{ "type": "text", "id": "why_2_tag", "label": "Etiqueta 2", "default": "A2" },
{ "type": "text", "id": "why_2_title", "label": "Motivo 2", "default": "Pensado para la primera moto" },
{ "type": "textarea", "id": "why_2_text", "label": "Texto 2", "default": "Cubre depósito, tapas laterales, frontal y colín: las zonas que se ven, sin piezas raras que sobren." },
{ "type": "text", "id": "why_3_tag", "label": "Etiqueta 3", "default": "✂" },
{ "type": "text", "id": "why_3_title", "label": "Motivo 3", "default": "Corte para tu generación" },
{ "type": "textarea", "id": "why_3_text", "label": "Texto 3", "default": "Un solo kit con plantillas para todos los años de MT-07. Indicas el tuyo y se troquela a medida." },
{ "type": "textarea", "id": "acabados_text", "label": "Texto de acabados", "default": "Este azul queda más fiel en brillo, con el tono limpio y profundo. En mate se apaga y deja la moto más sobria. En glitter añade destellos metálicos al sol." },
{ "type": "header", "content": "Qué incluye (una línea por elemento)" },
{ "type": "textarea", "id": "incluye", "label": "Incluido", "default": "Adhesivos para depósito\nAdhesivos para tapas laterales\nAdhesivos para frontal\nAdhesivos para colín\nCorte a medida de marca, modelo y año" },
{ "type": "textarea", "id": "aparte", "label": "Se pide aparte", "default": "cúpula\nparamanos\nllantas\nsuspensiones\nescape\nchasis\nradiador" },
{ "type": "header", "content": "Cómo funciona" },
{ "type": "textarea", "id": "step_1_text", "label": "Paso 1", "default": "Modelo y año, base y acabado, y los extras que quieras." },
{ "type": "header", "content": "Material y garantías" },
{ "type": "text", "id": "compat_text", "label": "Compatibilidad", "default": "Yamaha MT-07 · Todas las generaciones" },
{ "type": "text", "id": "envio_text", "label": "Envío", "default": "España gratis, 7 a 10 días laborables · UE 13,50 €, 8 a 12 días" },
{ "type": "text", "id": "envio_corto", "label": "Envío (resumen)", "default": "España, 7 a 10 días laborables. UE 13,50 €." },
{ "type": "text", "id": "devolucion_text", "label": "Devolución", "default": "30 días naturales en productos de catálogo sin usar" },
{ "type": "header", "content": "Preguntas frecuentes" },
{ "type": "text", "id": "faq_1_q", "label": "Pregunta 1", "default": "¿Vale para mi MT-07 de 2018?" },
{ "type": "textarea", "id": "faq_1_a", "label": "Respuesta 1", "default": "Sí. El kit es All Models: eliges el año en el paso 1 y cortamos con la plantilla de esa generación." },
{ "type": "text", "id": "faq_2_q", "label": "Pregunta 2", "default": "¿Se puede montar uno mismo?" },
{ "type": "textarea", "id": "faq_2_a", "label": "Respuesta 2", "default": "Sí, con paciencia, agua jabonosa y una rasqueta. Si prefieres no arriesgar, marca el montaje en el paso 3 y te damos cita en Martorell." },
{ "type": "text", "id": "faq_3_q", "label": "Pregunta 3", "default": "¿Tapa la pintura original?" },
{ "type": "textarea", "id": "faq_3_a", "label": "Respuesta 3", "default": "Solo las zonas del kit. Al retirarlo la pintura queda como estaba: es vinilo, no pintura." },
{ "type": "header", "content": "Montaje" },
{ "type": "image_picker", "id": "montaje_image", "label": "Foto del montaje" },
{ "type": "text", "id": "montaje_desde", "label": "Precio desde", "default": "60 €" }
],
"presets": [
{ "name": "Ficha borrador Carez" }
]
}
{% endschema %}
