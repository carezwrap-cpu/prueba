{% for value in base_option.values %}
{% liquid
# Las imágenes se asignan por POSICIÓN de la opción, no por su texto:
# los valores llegan traducidos según el idioma (Cromado→Chrome, Brillo→Gloss…)
# y una comparación por texto solo funcionaría en español.
assign swatch_image = null
case forloop.index0
when 0
assign swatch_image = block.settings.combo_normal_brillo
when 1
assign swatch_image = block.settings.combo_cromado_brillo
when 2
assign swatch_image = block.settings.combo_holografico_brillo
endcase
%}
<button
type="button"
class="cz-card-{{ block.id }}"
data-cz-card
data-option-name="Base"
data-option-value="{{ value | escape }}"
data-option-index="{{ forloop.index0 }}"
aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
>
<img data-cz-card-img src="{% if swatch_image %}{{ swatch_image | image_url: width: 500 }}{% endif %}" alt="{{ value | escape }}" loading="lazy" width="500" height="500">
<span class="cz-check-{{ block.id }}">&#10003;</span>
<span class="cz-card-footer-{{ block.id }}">
<span class="cz-card-name-{{ block.id }}">{{ value }}</span>
<span class="cz-card-price-{{ block.id }}" data-cz-price-badge>&nbsp;</span>
</span>
</button>
{% endfor %}
</div>
</div>
<div class="cz-section-{{ block.id }}">
<p class="cz-section-label-{{ block.id }}">{{ finish_option.name }}</p>
<div class="cz-grid-{{ block.id }}" data-cz-grid="Acabado">
