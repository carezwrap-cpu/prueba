function updateSummary() {
var variant = findVariant();
var adaptFee = isAdaptActive() ? ADAPT_FEE_CENTS : 0;
adaptFee += paidChanges() * CHANGE_FEE_CENTS;
var addonFee = addonControllers.reduce(function (sum, controller) {
var sel = controller.getSelection();
return sum + (sel ? sel.totalCents : 0);
}, 0);
var basePrice = variant ? variant.price : cheapestPrice;
var extras = (variant ? variant.price - cheapestPrice : 0) + adaptFee + addonFee;
if (extrasEl) extrasEl.textContent = '+' + formatMoney(extras);
if (totalEl) totalEl.textContent = formatMoney(basePrice + adaptFee + addonFee);
var parts = comboParts();
if (parts.length) {
if (selectedSummaryEl) selectedSummaryEl.textContent = parts.join(' + ');
if (triggerSubEl) triggerSubEl.textContent = parts.join(' · ');
}
if (confirmBtn && !confirmBtn.hasAttribute('data-cz-busy')) {
confirmBtn.disabled = !variant || variant.available === false || !requiredFieldsFilled();
}
}
function renderPriceBadges() {
