align-items: center;
gap: 10px;
padding: 14px 20px;
background: #17171a;
border: 1px solid rgba(201, 162, 75, 0.45);
border-radius: 10px;
color: #f2f1ee;
font-size: 13.5px;
font-weight: 600;
box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
opacity: 0;
pointer-events: none;
transform: translate(-50%, 10px);
transition: opacity 0.25s ease, transform 0.25s ease;
}
.cz-toast-{{ block.id }}[hidden] {
display: none;
}
.cz-toast-{{ block.id }}.cz-toast-visible-{{ block.id }} {
opacity: 1;
transform: translate(-50%, 0);
}
.cz-toast-{{ block.id }} svg {
width: 18px;
height: 18px;
color: #c9a24b;
flex-shrink: 0;
}
.cz-error-{{ block.id }} {
flex-shrink: 0;
margin: 0;
padding: 12px 24px;
background: #2a1113;
border-top: 1px solid #a42325;
color: #f2b8b9;
font-size: 13px;
font-weight: 600;
line-height: 1.4;
}
.cz-error-{{ block.id }}[hidden] {
display: none;
}
.cz-field-invalid-{{ block.id }} {
border-color: #a42325 !important;
box-shadow: 0 0 0 1px #a42325;
}
.cz-add-{{ block.id }}[data-cz-busy] {
opacity: 0.7;
cursor: progress;
}
.cz-dialog-fallback-{{ block.id }}[open] {
position: fixed;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
z-index: 9998;
margin: 0;
box-shadow: 0 0 0 100vmax rgba(0, 0, 0, 0.72);
}
.cz-scroll-lock-{{ block.id }} {
overflow: hidden;
}
.cz-preview-note-{{ block.id }} {
margin: 10px 0 0;
padding: 12px 14px;
border: 1px solid #c9a24b;
border-radius: 10px;
background: rgba(201, 162, 75, 0.12);
color: #f2f1ee;
font-size: 14px;
font-weight: 600;
line-height: 1.4;
}
.cz-preview-note-{{ block.id }}::before {
content: '\2713  ';
color: #c9a24b;
}
.cz-changes-{{ block.id }} {
display: flex;
flex-direction: column;
gap: 8px;
}
.cz-change-{{ block.id }} {
display: grid;
grid-template-columns: 82px 1fr auto;
gap: 10px;
align-items: center;
}
.cz-change-{{ block.id }}[hidden] {
display: none;
}
.cz-change-k-{{ block.id }} {
font-family: 'Barlow Condensed', Arial, sans-serif;
font-size: 15px;
font-weight: 700;
letter-spacing: 0.04em;
text-transform: uppercase;
color: #f2f1ee;
white-space: nowrap;
}
.cz-change-{{ block.id }} input[type='text'] {
width: 100%;
padding: 11px 12px;
background: #17171a;
border: 1px solid rgba(255, 255, 255, 0.12);
border-radius: 8px;
color: #f2f1ee;
font-size: 14px;
font-family: inherit;
}
.cz-change-{{ block.id }} input[type='text']:focus {
outline: none;
border-color: #c9a24b;
}
.cz-change-fee-{{ block.id }} {
font-size: 12px;
font-weight: 700;
color: #c9a24b;
white-space: nowrap;
min-width: 62px;
text-align: right;
}
.cz-change-fee-{{ block.id }}[data-paid] {
color: #f2f1ee;
}
@media screen and (max-width: 520px) {
.cz-change-{{ block.id }} {
grid-template-columns: 1fr auto;
}
.cz-change-k-{{ block.id }} {
grid-column: 1 / -1;
}
}
{% endstyle %}
