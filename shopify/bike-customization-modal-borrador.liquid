<script>
(function () {
var scope = document.currentScript.closest('.cz-modal-{{ block.id }}') || document.querySelector('.cz-modal-{{ block.id }}');
if (!scope) return;
var dialog = scope.querySelector('[data-cz-dialog]');
var openBtn = scope.querySelector('[data-cz-open]');
var closeBtn = scope.querySelector('[data-cz-close]');
var confirmBtn = scope.querySelector('[data-cz-confirm]');
var extrasEl = scope.querySelector('[data-cz-extras]');
var totalEl = scope.querySelector('[data-cz-total]');
var selectedSummaryEl = scope.querySelector('[data-cz-selected-summary]');
var triggerSubEl = scope.querySelector('[data-cz-trigger-sub]');
var fileInput = scope.querySelector('[data-cz-file-input]');
var fileNameEl = scope.querySelector('[data-cz-filename]');
var stepPanels = Array.prototype.slice.call(scope.querySelectorAll('[data-cz-step]'));
var stepIndicators = Array.prototype.slice.call(scope.querySelectorAll('[data-cz-step-indicator]'));
var stepBackBtn = scope.querySelector('[data-cz-step-back]');
var stepNextBtn = scope.querySelector('[data-cz-step-next]');
var stepAnnouncer = scope.querySelector('[data-cz-step-announcer]');
var toastEl = scope.querySelector('[data-cz-toast]');
var toastMessageEl = scope.querySelector('[data-cz-toast-message]');
var toastTimer = null;
var totalSteps = stepPanels.length;
var currentStep = 1;
var stepAnnouncements = {
1: {{ 'bike_customizer.step_announcement' | t: current: 1, total: 3, label: step_label_1 | json }},
2: {{ 'bike_customizer.step_announcement' | t: current: 2, total: 3, label: step_label_2 | json }},
3: {{ 'bike_customizer.step_announcement' | t: current: 3, total: 3, label: step_label_3 | json }}
};
var stepValidationError = {{ 'bike_customizer.step_validation_error' | t | json }};
var variantsScript = document.querySelector('[data-cz-variants-{{ block.id }}]');
var variants = [];
try {
variants = JSON.parse(variantsScript.textContent);
} catch (e) {
variants = [];
}
var comboImagesScript = document.querySelector('[data-cz-combo-images-{{ block.id }}]');
var comboImages = {};
try {
comboImages = JSON.parse(comboImagesScript.textContent);
} catch (e) {
comboImages = {};
}
var cheapestPrice = variants.reduce(function (min, v) {
return v.price < min ? v.price : min;
}, variants.length ? variants[0].price : 0);
var selection = { Base: null, Acabado: null };
var selectionIdx = { Base: null, Acabado: null };
var hasComboGrid = scope.querySelectorAll('[data-cz-card]').length > 0;
var initialCards = scope.querySelectorAll('[data-cz-card][aria-pressed="true"]');
initialCards.forEach(function (card) {
selection[card.dataset.optionName] = card.dataset.optionValue;
selectionIdx[card.dataset.optionName] = parseInt(card.dataset.optionIndex, 10);
});
var UI_LOCALE = {{ request.locale.iso_code | default: 'es' | json }};
var IS_EN = UI_LOCALE.indexOf('en') === 0;
var TXT = {
adding: IS_EN ? 'Adding…' : 'Añadiendo…',
uploading: IS_EN ? 'Uploading photos…' : 'Subiendo fotos…',
addError: IS_EN
? 'The product could not be added to the cart. Please check your connection and try again.'
: 'No se ha podido añadir el producto al carrito. Revisa tu conexión e inténtalo de nuevo.',
fileTooBig: IS_EN
? 'One of the photos is larger than 20 MB. Please use smaller photos and try again.'
: 'Una de las fotos supera los 20 MB. Usa fotos más ligeras e inténtalo de nuevo.',
photosRequired: IS_EN
? 'Please upload at least one reference photo to continue.'
: 'Sube al menos una foto de referencia para continuar.',
extraFailed: IS_EN
? 'The kit was added, but one extra could not be added. Please check your cart.'
: 'El kit se añadió, pero uno de los extras no pudo añadirse. Revisa tu carrito.'
};
var CART_ADD_URL = {{ routes.cart_add_url | json }} + '.js';
var CART_CHANGE_URL = {{ routes.cart_change_url | json }} + '.js';
var CART_JS_URL = {{ routes.cart_url | json }} + '.js';
var MAX_FILE_BYTES = 20 * 1024 * 1024;
function formatMoney(cents) {
return (cents / 100).toLocaleString(UI_LOCALE, { style: 'currency', currency: '{{ cart.currency.iso_code | default: shop.currency }}' });
}
function findVariant() {
var exact = variants.find(function (v) {
return v.base === selection.Base && v.acabado === selection.Acabado;
});
if (exact) return exact;
if (!hasComboGrid) {
return variants.find(function (v) { return v.available !== false; }) || variants[0];
}
return undefined;
}
function comboParts() {
return [selection.Base, selection.Acabado].filter(Boolean);
}
function comboLabel() {
var parts = comboParts();
return parts.length ? parts.join(' + ') : {{ product.title | json }};
}
var ADAPT_FEE_VARIANT_ID = '{{ block.settings.adapt_fee_variant_id | default: "62259251806595" }}';
var ADAPT_FEE_CENTS = 2000;
var CHANGE_FEE_VARIANT_ID = '{{ block.settings.change_fee_variant_id }}';
var CHANGE_FEE_CENTS = 999;
var CHANGE_FREE = 2;
var changeRows = Array.prototype.slice.call(scope.querySelectorAll('[data-cz-change-row]'));
function changeValues() {
return changeRows.map(function (r) { var i = r.querySelector('input'); return i && i.value ? i.value.trim() : ''; });
}
function paidChanges() {
var vals = changeValues();
var n = 0;
for (var i = CHANGE_FREE; i < vals.length; i++) { if (vals[i]) n++; }
return n;
}
function refreshChanges() {
var vals = changeValues();
var lastFilled = -1;
for (var i = 0; i < vals.length; i++) { if (vals[i]) lastFilled = i; }
changeRows.forEach(function (r, i) {
if (i <= lastFilled + 1) { r.removeAttribute('hidden'); }
else { r.setAttribute('hidden', ''); var inp = r.querySelector('input'); if (inp) inp.value = ''; }
});
}
changeRows.forEach(function (r) {
var inp = r.querySelector('input');
if (!inp) return;
inp.addEventListener('input', function () { refreshChanges(); });
inp.addEventListener('blur', function () { refreshChanges(); });
});
function isAdaptActive() {
var btn = scope.querySelector('[data-cz-toggle="adapt_bike"]');
return !!(btn && btn.getAttribute('aria-pressed') === 'true');
}
var IS_COARSE_POINTER = !!(window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
scope
.querySelectorAll(
'[data-cz-card], [data-cz-addon-option], [data-cz-addon-toggle], [data-cz-addon-remove], [data-cz-toggle], [data-cz-step-next], [data-cz-step-back], [data-cz-confirm], [data-cz-close]'
)
.forEach(function (btn) {
btn.addEventListener('pointerdown', function (event) {
if (!IS_COARSE_POINTER) return;
event.preventDefault();
});
});
function esScrollerCz(el) {
if (!el) return false;
var ov = window.getComputedStyle(el).overflowY;
return (ov === 'auto' || ov === 'scroll') && el.scrollHeight > el.clientHeight + 1;
}
function scrollerModal() {
var cuerpo = dialog.querySelector('.cz-body-{{ block.id }}');
return esScrollerCz(cuerpo) ? cuerpo : dialog;
}
function mantenerALaVista(el) {
if (!el) return;
var scroller = scrollerModal();
if (!scroller) return;
var cabecera = dialog.querySelector('.cz-panel-head-{{ block.id }}');
var margen = 16 + (cabecera ? cabecera.offsetHeight : 0);
var r = el.getBoundingClientRect();
var rs = scroller.getBoundingClientRect();
if (r.top < rs.top + margen) {
scroller.scrollTop -= rs.top + margen - r.top;
}
}
function createAddonController(groupKey, emptySummaryText, emptyBadgeText, selectedSuffix) {
var trigger = scope.querySelector('[data-cz-addon-toggle="' + groupKey + '"]');
var panel = scope.querySelector('[data-cz-addon-panel="' + groupKey + '"]');
var summaryEl = scope.querySelector('[data-cz-addon-summary="' + groupKey + '"]');
var badgeEl = scope.querySelector('[data-cz-addon-price-badge="' + groupKey + '"]');
if (!trigger || !panel) return null;
function getSelection() {
var pressed = panel.querySelector('[data-cz-addon-option][aria-pressed="true"]');
if (!pressed) return null;
return {
variantId: pressed.dataset.variantId,
totalCents: parseInt(pressed.dataset.totalCents, 10) || 0,
unitsLabel: pressed.dataset.unitsLabel
};
}
function close() {
panel.setAttribute('hidden', '');
trigger.setAttribute('aria-expanded', 'false');
}
function updateDisplay() {
var selected = getSelection();
if (selected) {
if (summaryEl) summaryEl.textContent = selected.unitsLabel + selectedSuffix;
if (badgeEl) badgeEl.textContent = formatMoney(selected.totalCents);
} else {
if (summaryEl) summaryEl.textContent = emptySummaryText;
if (badgeEl) badgeEl.textContent = emptyBadgeText;
}
}
trigger.addEventListener('click', function () {
var isOpen = trigger.getAttribute('aria-expanded') === 'true';
if (isOpen) {
close();
} else {
panel.removeAttribute('hidden');
trigger.setAttribute('aria-expanded', 'true');
}
});
panel.querySelectorAll('[data-cz-addon-option]').forEach(function (opt) {
opt.addEventListener('click', function () {
panel.querySelectorAll('[data-cz-addon-option]').forEach(function (o) {
o.setAttribute('aria-pressed', 'false');
});
opt.setAttribute('aria-pressed', 'true');
updateDisplay();
updateSummary();
});
});
var removeBtn = panel.querySelector('[data-cz-addon-remove]');
if (removeBtn) {
removeBtn.addEventListener('click', function () {
panel.querySelectorAll('[data-cz-addon-option]').forEach(function (o) {
o.setAttribute('aria-pressed', 'false');
});
close();
updateDisplay();
updateSummary();
mantenerALaVista(trigger);
});
}
return { getSelection: getSelection, updateDisplay: updateDisplay };
}
function renderAddonOptions() {
scope.querySelectorAll('[data-cz-addon-option]').forEach(function (opt) {
var priceEl = opt.querySelector('[data-cz-addon-option-price]');
if (!priceEl) return;
var extra = parseInt(opt.dataset.extraCents, 10) || 0;
var before = parseInt(opt.dataset.beforeCents, 10) || 0;
var total = parseInt(opt.dataset.totalCents, 10) || 0;
if (extra > 0) {
var html = '+' + formatMoney(extra);
if (before > 0) html += ' <s>' + {{ 'bike_customizer.before' | t | json }} + ' +' + formatMoney(before) + '</s>';
priceEl.innerHTML = html;
} else {
priceEl.textContent = formatMoney(total);
}
});
}
function requiredFieldsFilled() {
var fields = scope.querySelectorAll('[data-cz-required]');
for (var i = 0; i < fields.length; i++) {
if (!fields[i].value || !fields[i].value.trim()) return false;
}
if (fileInput && fileInput.hasAttribute('data-cz-file-required')) {
if (!fileInput.files || fileInput.files.length === 0) return false;
}
return true;
}
function validateStep(stepNumber) {
var panel = stepPanels.filter(function (p) { return parseInt(p.dataset.czStep, 10) === stepNumber; })[0];
if (!panel) return true;
var fields = panel.querySelectorAll('[data-cz-required]');
for (var i = 0; i < fields.length; i++) {
if (!fields[i].value || !fields[i].value.trim()) return false;
}
var stepFileInput = panel.querySelector('[data-cz-file-input][data-cz-file-required]');
if (stepFileInput && (!stepFileInput.files || stepFileInput.files.length === 0)) return false;
return true;
}
var errorEl = scope.querySelector('[data-cz-error]');
function showError(message) {
if (!errorEl) return;
errorEl.textContent = message;
errorEl.removeAttribute('hidden');
if (stepAnnouncer) stepAnnouncer.textContent = message;
}
function hideError() {
if (errorEl) errorEl.setAttribute('hidden', '');
}
function markFieldInvalid(field, invalid) {
if (!field) return;
field.classList.toggle('cz-field-invalid-{{ block.id }}', !!invalid);
}
function showToast(message) {
if (!toastEl) return;
if (toastMessageEl) toastMessageEl.textContent = message || {{ 'bike_customizer.add_success' | t | json }};
toastEl.removeAttribute('hidden');
window.clearTimeout(toastTimer);
window.requestAnimationFrame(function () {
toastEl.classList.add('cz-toast-visible-{{ block.id }}');
});
toastTimer = window.setTimeout(function () {
toastEl.classList.remove('cz-toast-visible-{{ block.id }}');
window.setTimeout(function () {
toastEl.setAttribute('hidden', '');
}, 260);
}, 2600);
}
function showStep(stepNumber, options) {
options = options || {};
stepNumber = Math.min(Math.max(stepNumber, 1), totalSteps);
stepPanels.forEach(function (panel) {
var isCurrent = parseInt(panel.dataset.czStep, 10) === stepNumber;
if (isCurrent) {
