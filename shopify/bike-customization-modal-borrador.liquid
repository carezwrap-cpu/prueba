function addLineVerified(variantId, properties, quantity) {
return fetch(CART_ADD_URL, {
method: 'POST',
headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: quantity || 1, properties: properties }] })
}).then(function (res) {
return res.json().then(function (json) {
var ok = res.ok && !json.status;
var key = ok && json.items && json.items[0] ? json.items[0].key : null;
return { ok: ok, key: key, message: json.message || json.description || '' };
}).catch(function () { return { ok: res.ok, key: null, message: '' }; });
}, function () { return { ok: false, key: null, message: '' }; });
}
function removeLineByKey(key) {
if (!key) return Promise.resolve();
return fetch(CART_CHANGE_URL, {
method: 'POST',
headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
body: JSON.stringify({ id: key, quantity: 0 })
}).catch(function () {});
}
function getCartCount() {
return fetch(CART_JS_URL, { headers: { 'Accept': 'application/json' } })
.then(function (res) { return res.json(); })
.then(function (cart) { return cart.item_count || 0; })
.catch(function () { return null; });
}
function awaitThemeAddOutcome(countBefore, timeoutMs) {
return new Promise(function (resolve) {
var settled = false;
var timer = null;
function settle(ok) {
if (settled) return;
settled = true;
window.clearTimeout(timer);
document.removeEventListener('shopify:cart:lines-update', onLines, true);
document.removeEventListener('shopify:cart:error', onError, true);
resolve(ok);
}
function onLines(ev) {
if (!ev || !ev.promise) return;
ev.promise.then(function (result) {
var detail = result && result.detail;
settle(!(detail && detail.didError));
}).catch(function () { settle(false); });
}
function onError() { settle(false); }
document.addEventListener('shopify:cart:lines-update', onLines, true);
document.addEventListener('shopify:cart:error', onError, true);
timer = window.setTimeout(function () {
getCartCount().then(function (countAfter) {
settle(countAfter !== null && countBefore !== null && countAfter > countBefore);
});
}, timeoutMs);
});
}
function setBusy(busy, withFiles) {
if (!confirmBtn) return;
if (busy) {
confirmBtn.dataset.czOriginalText = confirmBtn.dataset.czOriginalText || confirmBtn.textContent;
confirmBtn.textContent = withFiles ? TXT.uploading : TXT.adding;
confirmBtn.setAttribute('data-cz-busy', '');
confirmBtn.disabled = true;
} else {
if (confirmBtn.dataset.czOriginalText) confirmBtn.textContent = confirmBtn.dataset.czOriginalText;
confirmBtn.removeAttribute('data-cz-busy');
confirmBtn.disabled = false;
updateSummary();
}
}
function cleanupInjectedInputs(form) {
if (!form) return;
form.querySelectorAll('input[type="file"][data-cz-injected]').forEach(function (el) { el.remove(); });
form.querySelectorAll('[data-cz-injected-prop]').forEach(function (el) { el.remove(); });
}
if (confirmBtn) {
var confirmInFlight = false;
confirmBtn.addEventListener('click', function () {
if (confirmInFlight) return;
hideError();
var variant = findVariant();
if (!variant) { showError(TXT.addError); return; }
for (var s = 1; s <= totalSteps; s++) {
if (!validateStep(s)) {
showStep(s);
showError(stepValidationError);
return;
}
}
var hasFiles = !!(fileInput && fileInput.files && fileInput.files.length);
if (hasFiles) {
for (var f = 0; f < fileInput.files.length; f++) {
if (fileInput.files[f].size > MAX_FILE_BYTES) {
showError(TXT.fileTooBig);
return;
}
}
}
var sectionEl = scope.closest('.shopify-section') || document;
var form = sectionEl.querySelector('product-form-component form[data-type="add-to-cart-form"]')
|| document.querySelector('product-form-component form[data-type="add-to-cart-form"]');
confirmInFlight = true;
setBusy(true, hasFiles);
var extraItems = [];
if (isAdaptActive() && ADAPT_FEE_VARIANT_ID) {
var adaptTextarea = scope.querySelector('[data-cz-prop="Adaptación a otra moto"]');
extraItems.push({
id: ADAPT_FEE_VARIANT_ID,
properties: {
'Aplica a': comboLabel(),
'Detalle': adaptTextarea && adaptTextarea.value ? adaptTextarea.value : 'Sin detalle indicado'
}
});
}
addonControllers.forEach(function (controller) {
var sel = controller.getSelection();
if (sel && sel.variantId) extraItems.push({ id: sel.variantId, properties: { 'Aplica a': comboLabel() } });
});
var paidN = paidChanges();
if (paidN > 0 && CHANGE_FEE_VARIANT_ID) {
var paidList = changeValues().slice(CHANGE_FREE).filter(Boolean).join(' | ');
extraItems.push({ id: CHANGE_FEE_VARIANT_ID, quantity: paidN, properties: { 'Aplica a': comboLabel(), 'Cambios extra': paidList } });
}
var addedExtraKeys = [];
var anyExtraFailed = false;
function addExtrasSequentially(index) {
if (index >= extraItems.length) return Promise.resolve();
return addLineVerified(extraItems[index].id, extraItems[index].properties, extraItems[index].quantity).then(function (result) {
if (result.ok && result.key) addedExtraKeys.push(result.key);
if (!result.ok) anyExtraFailed = true;
return addExtrasSequentially(index + 1);
});
}
getCartCount().then(function (countBefore) {
return addExtrasSequentially(0).then(function () {
if (form) {
var idInput = form.querySelector('input[name="id"]');
if (idInput) idInput.value = variant.id;
cleanupInjectedInputs(form);
if (hasFiles) {
form.enctype = 'multipart/form-data';
var totalFiles = fileInput.files.length;
Array.prototype.forEach.call(fileInput.files, function (file, index) {
var clonedFile = document.createElement('input');
clonedFile.type = 'file';
var propName = totalFiles > 1 ? 'properties[Foto ' + (index + 1) + ']' : 'properties[Foto de la moto]';
clonedFile.setAttribute('name', propName);
clonedFile.setAttribute('data-cz-injected', 'true');
clonedFile.style.display = 'none';
form.appendChild(clonedFile);
try {
var dt = new DataTransfer();
dt.items.add(file);
clonedFile.files = dt.files;
} catch (e) {
clonedFile.remove();
}
});
}
scope.querySelectorAll('[data-cz-prop]').forEach(function (field) {
var value = field.value;
if (!value) return;
var hidden = document.createElement('input');
hidden.type = 'hidden';
hidden.name = 'properties[' + field.dataset.czProp + ']';
hidden.value = value;
hidden.setAttribute('data-cz-injected-prop', 'true');
form.appendChild(hidden);
});
var countAfterExtras = countBefore === null ? null : countBefore + addedExtraKeys.length;
var outcomePromise = awaitThemeAddOutcome(countAfterExtras, hasFiles ? 90000 : 15000);
var submitButton = form.querySelector('[ref="addToCartButton"]') || form.querySelector('button[type="submit"]');
if (submitButton && !submitButton.disabled) {
submitButton.click();
} else if (typeof form.requestSubmit === 'function') {
form.requestSubmit();
} else {
form.submit();
}
return outcomePromise;
}
var directProps = {};
scope.querySelectorAll('[data-cz-prop]').forEach(function (field) {
if (field.value) directProps[field.dataset.czProp] = field.value;
});
return addLineVerified(variant.id, directProps).then(function (result) { return result.ok; });
});
}).then(function (mainOk) {
cleanupInjectedInputs(form);
if (mainOk) {
confirmInFlight = false;
setBusy(false, false);
closeDialog();
showToast(anyExtraFailed ? TXT.extraFailed : null);
} else {
addedExtraKeys.forEach(function (key) { removeLineByKey(key); });
confirmInFlight = false;
setBusy(false, false);
showError(TXT.addError);
}
}).catch(function () {
cleanupInjectedInputs(form);
addedExtraKeys.forEach(function (key) { removeLineByKey(key); });
confirmInFlight = false;
setBusy(false, false);
showError(TXT.addError);
});
});
}
window.addEventListener('pageshow', function (event) {
if (event.persisted) {
setBusy(false, false);
hideError();
if (!dialog.hasAttribute('open')) unlockScroll();
}
});
renderPriceBadges();
renderAddonOptions();
addonControllers.forEach(function (controller) { controller.updateDisplay(); });
showStep(1, { skipFocus: true });
})();
</script>
