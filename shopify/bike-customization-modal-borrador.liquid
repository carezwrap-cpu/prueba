var matching = variants.filter(function (v) { return v[key] === value; });
var minPrice = matching.reduce(function (min, v) {
return v.price < min ? v.price : min;
}, matching.length ? matching[0].price : cheapestPrice);
var diff = minPrice - cheapestPrice;
var badge = card.querySelector('[data-cz-price-badge]');
